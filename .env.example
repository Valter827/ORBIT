# Local development only. Keep .env out of version control.
ANTHROPIC_API_KEY=
# Optional absolute workspace; default is demos/failing-add
# ORBIT_WORKSPACE=C:\Projects\demo
# Optional private state directory OUTSIDE the workspace
# ORBIT_STATE_DIR=C:\Users\you\AppData\Local\ORBIT
ORBIT_VERIFY_COMMAND=npm test
PORT=4317
# Optional existing database integration tests, not needed for UI:
# DATABASE_URL=postgresql://orbit:password@localhost:5432/orbit
# ORBIT_LIVE_TESTS=1
