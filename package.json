{
  "name": "orbit",
  "version": "0.10.1",
  "description": "ORBIT — Personal AI Agent. Your computer, understood.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json",
    "build": "tsc",
    "test": "npm run build && node --test \"dist/packages/core/test/*.test.js\"",
    "test:unit": "npm test",
    "lint": "eslint packages/core/src packages/core/test frontend/src --max-warnings 0",
    "format": "prettier --write \"packages/core/**/*.ts\" \"frontend/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/core/**/*.ts\" \"frontend/**/*.{ts,tsx}\"",
    "db:apply": "psql \"$DATABASE_URL\" -f prisma/sql/001_init.sql",
    "start": "node --env-file-if-exists=.env dist/packages/core/src/server.js",
    "desktop:dev": "npm run dev:desktop",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "installer:win": "npm run build:desktop",
    "dev": "npm run dev:desktop",
    "dev:desktop": "node scripts/prepare-desktop.mjs && node scripts/tauri.mjs dev",
    "tauri:dev": "npm run dev:desktop",
    "tauri": "node scripts/tauri.mjs",
    "frontend:dev": "vite",
    "frontend:build": "tsc -p tsconfig.frontend.json && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop:build": "npm run build:desktop",
    "icons": "tauri icon assets/orbit.svg --output src-tauri/icons",
    "test:desktop-ui": "npm run build && npm run frontend:build && node scripts/desktop-ui-smoke.mjs",
    "build:production": "node scripts/build-desktop.mjs --production",
    "test:release": "node --test scripts/release-pipeline.test.mjs",
    "check:release": "node scripts/release-checks.mjs",
    "test:visual-security": "node --test scripts/visual-security.test.mjs"
  },
  "keywords": [
    "orbit",
    "ai-agent",
    "desktop"
  ],
  "author": "ORBIT",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "jszip": "3.10.2",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "htmlparser2": "12.0.0",
    "katex": "0.19.0",
    "lucide-react": "1.52.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=24"
  },
  "productName": "ORBIT",
  "packageManager": "npm@11.16.0",
  "overrides": {
    "katex": "$katex"
  }
}
